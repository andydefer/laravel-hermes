{
    "name": "andydefer/laravel-hermes",
    "description": "Hermes - Intelligent text similarity, completion, suggestion and search service for Laravel, powered by n-grams and metaphone algorithms.",
    "keywords": [
        "laravel",
        "hermes",
        "similarity",
        "completion",
        "suggestion",
        "search",
        "text-analysis",
        "n-gram",
        "metaphone",
        "levenshtein",
        "fuzzy-search"
    ],
    "homepage": "https://github.com/andydefer/laravel-hermes",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "AndyDefer\\LaravelHermes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndyDefer\\LaravelHermes\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Andy Kani",
            "email": "andykanidimbu@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^12.0|^13.0|^14.0|^15.0",
        "andydefer/laravel-indexer": "^0.15.10"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.29",
        "laravel/tinker": "^2.11"
    },
    "suggest": {
        "andydefer/laravel-indexer": "Required for indexing and search capabilities"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AndyDefer\\LaravelHermes\\Providers\\HermesServiceProvider"
            ],
            "aliases": {
                "Hermes": "AndyDefer\\LaravelHermes\\Facades\\Hermes"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
